{
  "name": "@readme/oxlint-config",
  "version": "15.0.9",
  "description": "ReadMe coding standards for projects with Oxlint",
  "homepage": "https://github.com/readmeio/standards#readme",
  "bugs": {
    "url": "https://github.com/readmeio/standards/issues"
  },
  "license": "MIT",
  "author": "Jon Ursenbach <jon@ursenba.ch>",
  "repository": {
    "type": "git",
    "url": "git@github.com:readmeio/standards.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./oxfmt": {
      "types": "./src/formatter.d.ts",
      "default": "./src/formatter.js"
    },
    "./typescript": {
      "types": "./src/typescript.d.ts",
      "default": "./src/typescript.js"
    },
    "./testing/jest": {
      "types": "./src/testing/jest.d.ts",
      "default": "./src/testing/jest.js"
    },
    "./testing/vitest": {
      "types": "./src/testing/vitest.d.ts",
      "default": "./src/testing/vitest.js"
    }
  },
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint .",
    "test": "npm run lint && npm run format"
  },
  "dependencies": {
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-readme": "^15.0.9",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0"
  }
}
